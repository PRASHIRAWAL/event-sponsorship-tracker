# Copy to .env (git-ignored) and change the passwords before running: docker compose up -d --build
DB_USERNAME=eventtracker
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Host ports for the compose stack (Jenkins deploys use 80 and 8081, so these default elsewhere)
NGINX_PORT=8088
APP_PORT=8089
# Seed sample events, sponsors and payments on an empty database
APP_DEMO_DATA=true
